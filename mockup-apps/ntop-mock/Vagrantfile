# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# Vagrant box for the ntopng mock.
# Provider : libvirt (KVM)
# Box      : bento/ubuntu-24.04
#
# ── Configuration ────────────────────────────────────────────────────────────
# Set the number of mock instances. Each gets its own IP:
#   1 → 192.168.128.10
#   2 → 192.168.128.10, 192.168.128.11
#
NUM_MOCKS = 1
BASE_IP   = "192.168.128"
START_OCT = 10
NET_NAME  = "mockup-ntop"

MOCK_IPS = (0...NUM_MOCKS).map { |i| "#{BASE_IP}.#{START_OCT + i}" }

Vagrant.configure("2") do |config|
  config.vm.box      = "bento/ubuntu-24.04"
  config.vm.hostname = "ntop-mock"

  # ── Networking ─────────────────────────────────────────────────────────────
  config.vm.network "private_network",
    ip:                       MOCK_IPS[0],
    libvirt__network_name:    NET_NAME,
    libvirt__dhcp_enabled:    false,
    libvirt__forward_mode:    "route"

  # ── Provider ───────────────────────────────────────────────────────────────
  config.vm.provider :libvirt do |lv|
    lv.driver         = "kvm"
    lv.memory         = 1024
    lv.cpus           = 1
    lv.disk_bus       = "virtio"
    lv.nic_model_type = "virtio"
    lv.title          = "ntop-mock"
    lv.description    = "ntopng REST API mock for Checkmk CEE (#{NUM_MOCKS} instance(s))"
  end

  # ── Provision: Docker ──────────────────────────────────────────────────────
  config.vm.provision "shell", name: "docker", inline: <<~SHELL
    set -euo pipefail
    export DEBIAN_FRONTEND=noninteractive

    apt-get update -qq
    apt-get install -y -qq ca-certificates curl gnupg

    install -m 0755 -d /etc/apt/keyrings
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
      | gpg --batch --yes --dearmor -o /etc/apt/keyrings/docker.gpg
    chmod a+r /etc/apt/keyrings/docker.gpg

    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
      https://download.docker.com/linux/ubuntu \
      $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
      | tee /etc/apt/sources.list.d/docker.list > /dev/null

    apt-get update -qq
    apt-get install -y -qq --no-install-recommends docker-ce docker-ce-cli containerd.io docker-compose-plugin

    usermod -aG docker vagrant
    systemctl enable --now docker
    echo "Docker $(docker --version) installed."
  SHELL

  # ── Provision: secondary IPs (netplan) ─────────────────────────────────────
  if NUM_MOCKS > 1
    secondary_ips = MOCK_IPS[1..].join(" ")
    config.vm.provision "shell", name: "secondary-ips", inline: <<~SHELL
      set -euo pipefail

      IFACE=$(ip -o addr show | awk '/#{MOCK_IPS[0]}/ {print $2}')
      echo "Adding secondary IPs to interface: $IFACE"

      cat > /etc/netplan/60-ntop-mock-secondaries.yaml << EOF
      network:
        version: 2
        ethernets:
          $IFACE:
            addresses:
      #{MOCK_IPS[1..].map { |ip| "          - #{ip}/24" }.join("\n")}
      EOF

      chmod 600 /etc/netplan/60-ntop-mock-secondaries.yaml
      netplan apply
      echo "Secondary IPs configured: #{secondary_ips}"
    SHELL
  end

  # ── Provision: generate docker-compose and start mocks ─────────────────────
  services = MOCK_IPS.each_with_index.map do |ip, i|
    n = i + 1
    block = <<~SVC
      ntop-mock-#{n}:
        build:
          context: .
          dockerfile: Dockerfile
        container_name: ntop-mock-#{n}
        ports:
          - "#{ip}:3000:3000"
        environment:
          - PYTHONUNBUFFERED=1
        restart: unless-stopped
        healthcheck:
          test: ["CMD", "python", "-c",
                 "import urllib.request, base64; req=urllib.request.Request('http://localhost:3000/lua/rest/version.lua'); req.add_header('Authorization','Basic '+base64.b64encode(b'admin:admin').decode()); urllib.request.urlopen(req)"]
          interval: 30s
          timeout: 10s
          retries: 3
          start_period: 10s
    SVC
    block.gsub(/^/, "  ")
  end

  compose_content = "services:\n#{services.join("\n")}\n"

  config.vm.provision "shell", name: "mock", privileged: false,
    env: { "COMPOSE_CONTENT" => compose_content },
    inline: <<~SHELL
      set -euo pipefail

      mkdir -p ~/docker/ntop-mock
      rsync -a --exclude='.vagrant' /vagrant/docker/ntop-mock/ ~/docker/ntop-mock/
      cd ~/docker/ntop-mock

      echo "$COMPOSE_CONTENT" > docker-compose.yml

      sg docker -c "/usr/bin/docker compose build --pull"
      sg docker -c "/usr/bin/docker compose up -d"

      echo "Waiting for ntop-mock-1 to be ready..."
      for j in $(seq 1 30); do
        if sg docker -c "/usr/bin/docker exec ntop-mock-1 python -c \
            'import urllib.request; urllib.request.urlopen(\"http://localhost:3000/lua/rest/version.lua\")'" 2>/dev/null; then
          echo "  ntop-mock-1: ready."
          break
        fi
        echo "  (${j}/30) not ready yet..."
        sleep 2
      done

      echo ""
      echo "══════════════════════════════════════════════════════"
      #{MOCK_IPS.each_with_index.map { |ip, i|
        n = i + 1
        "echo \"  [#{n}] http://#{ip}:3000  (ntop-mock-#{n})\""
      }.join("\n      ")}
      echo ""
      echo "  No TLS — configure Checkmk with protocol: http"
      echo ""
      echo "  Checkmk Global Settings > ntopng connection:"
      echo "    protocol      : http"
      echo "    port          : 3000"
      echo "    admin_username: admin"
      echo "    admin_password: admin"
      echo "══════════════════════════════════════════════════════"
    SHELL

  # ── Sync shared folder ──────────────────────────────────────────────────────
  config.vm.synced_folder ".", "/vagrant", type: "rsync",
    rsync__exclude: [".vagrant/", "*.pyc", "__pycache__/"]
end
