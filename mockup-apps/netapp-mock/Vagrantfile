# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# Vagrant box for the NetApp ONTAP mock.
# Provider : libvirt (KVM)
# Box      : bento/ubuntu-24.04
#
# ── Configuration ────────────────────────────────────────────────────────────
# Set the number of mock instances. Each gets its own IP:
#   1 → 192.168.125.10
#   2 → 192.168.125.10, 192.168.125.11
#   3 → 192.168.125.10, 192.168.125.11, 192.168.125.12  …
#
NUM_MOCKS  = 2
BASE_IP    = "192.168.125"
START_OCT  = 10
NET_NAME   = "mockup-netapp"

# Derived list of IPs
MOCK_IPS = (0...NUM_MOCKS).map { |i| "#{BASE_IP}.#{START_OCT + i}" }

Vagrant.configure("2") do |config|
  config.vm.box      = "bento/ubuntu-24.04"
  config.vm.hostname = "netapp-mock"

  # ── Networking ──────────────────────────────────────────────────────────────
  # Primary IP (always present)
  config.vm.network "private_network",
    ip:                       MOCK_IPS[0],
    libvirt__network_name:    NET_NAME,
    libvirt__dhcp_enabled:    false,
    libvirt__forward_mode:    "route"

  # ── Provider ────────────────────────────────────────────────────────────────
  config.vm.provider :libvirt do |lv|
    lv.driver         = "kvm"
    lv.memory         = 2048
    lv.cpus           = 2
    lv.disk_bus       = "virtio"
    lv.nic_model_type = "virtio"
    lv.title          = "netapp-mock"
    lv.description    = "NetApp ONTAP REST API mock for CheckMK (#{NUM_MOCKS} instance(s))"
  end

  # ── Provision: Docker + Docker Compose ──────────────────────────────────────
  config.vm.provision "shell", name: "docker", inline: <<~SHELL
    set -euo pipefail
    export DEBIAN_FRONTEND=noninteractive

    apt-get update -qq
    apt-get install -y -qq ca-certificates curl gnupg

    install -m 0755 -d /etc/apt/keyrings

    curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
      | gpg --batch --yes --dearmor -o /etc/apt/keyrings/docker.gpg
    chmod a+r /etc/apt/keyrings/docker.gpg

    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
      https://download.docker.com/linux/ubuntu \
      $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
      | tee /etc/apt/sources.list.d/docker.list > /dev/null

    apt-get update -qq
    apt-get install -y -qq --no-install-recommends docker-ce docker-ce-cli containerd.io docker-compose-plugin

    usermod -aG docker vagrant
    systemctl enable --now docker
    echo "Docker $(docker --version) installed."
  SHELL

  # ── Provision: secondary IPs (netplan) ──────────────────────────────────────
  if NUM_MOCKS > 1
    secondary_ips = MOCK_IPS[1..].join(" ")
    config.vm.provision "shell", name: "secondary-ips", inline: <<~SHELL
      set -euo pipefail

      # Find the interface that holds the primary mock IP
      IFACE=$(ip -o addr show | awk '/#{MOCK_IPS[0]}/ {print $2}')
      echo "Adding secondary IPs to interface: $IFACE"

      # Write a netplan drop-in for the secondary addresses
      cat > /etc/netplan/60-netapp-mock-secondaries.yaml << EOF
      network:
        version: 2
        ethernets:
          $IFACE:
            addresses:
      #{MOCK_IPS[1..].map { |ip| "          - #{ip}/24" }.join("\n")}
      EOF

      chmod 600 /etc/netplan/60-netapp-mock-secondaries.yaml
      netplan apply
      echo "Secondary IPs configured: #{secondary_ips}"
    SHELL
  end

  # ── Provision: generate docker-compose and start mocks ──────────────────────
  # Build the docker-compose.yml content in Ruby so it scales with NUM_MOCKS
  services = MOCK_IPS.each_with_index.map do |ip, i|
    n = i + 1
    # Build block then indent 2 spaces so it sits correctly under "services:"
    block = <<~SVC
      netapp-mock-#{n}:
        build:
          context: .
          dockerfile: Dockerfile
        container_name: netapp-mock-#{n}
        ports:
          - "#{ip}:443:443"
        volumes:
          - netapp-certs-#{n}:/app/certs
        environment:
          EXTRA_SANS: "IP:#{ip},DNS:netapp-mock-#{n}"
          LOG_LEVEL: "info"
          GUNICORN_WORKERS: "2"
          GUNICORN_THREADS: "4"
        restart: unless-stopped
        healthcheck:
          test: ["CMD", "curl", "-fsk", "https://localhost/api/cluster"]
          interval: 30s
          timeout: 10s
          retries: 3
          start_period: 15s
    SVC
    block.gsub(/^/, "  ")
  end

  volumes = MOCK_IPS.each_with_index.map { |_, i| "  netapp-certs-#{i + 1}:" }.join("\n")

  compose_content = "services:\n#{services.join("\n")}\nvolumes:\n#{volumes}\n"

  config.vm.provision "shell", name: "mock", privileged: false,
    env: { "COMPOSE_CONTENT" => compose_content },
    inline: <<~SHELL
      set -euo pipefail

      mkdir -p ~/netapp-mock
      rsync -a --exclude='.vagrant' /vagrant/ ~/netapp-mock/
      cd ~/netapp-mock

      # Write the generated docker-compose.yml
      echo "$COMPOSE_CONTENT" > docker-compose.yml

      sg docker -c "/usr/bin/docker compose build --pull"
      sg docker -c "/usr/bin/docker compose up -d"

      # ── Wait for certs and export them ──────────────────────────────────────
      #{MOCK_IPS.each_with_index.map { |ip, i|
        n = i + 1
        <<~WAIT
          echo "Waiting for cert on netapp-mock-#{n} (#{ip})..."
          for j in $(seq 1 30); do
            if sg docker -c "/usr/bin/docker exec netapp-mock-#{n} test -f /app/certs/cert.pem" 2>/dev/null; then
              echo "  netapp-mock-#{n}: certificate ready."
              break
            fi
            echo "  (${j}/30) not ready yet..."
            sleep 2
          done
          sg docker -c "/usr/bin/docker exec netapp-mock-#{n} cat /app/certs/cert.pem" \
            > ~/netapp-mock/netapp-mock-#{n}.crt
          cp ~/netapp-mock/netapp-mock-#{n}.crt /vagrant/netapp-mock-#{n}.crt
        WAIT
      }.join("\n")}

      echo ""
      echo "══════════════════════════════════════════════════════"
      #{MOCK_IPS.each_with_index.map { |ip, i|
        n = i + 1
        "echo \"  [#{n}] https://#{ip}  →  cert: netapp-mock-#{n}.crt\""
      }.join("\n      ")}
      echo ""
      echo "  Import certs into CheckMK:"
      echo "  cp netapp-mock-*.crt /omd/sites/<site>/etc/ssl/ca-certificates/"
      echo "  omd reload <site>"
      echo "══════════════════════════════════════════════════════"
    SHELL

  # ── Sync shared folder ───────────────────────────────────────────────────────
  config.vm.synced_folder ".", "/vagrant", type: "rsync",
    rsync__exclude: [".vagrant/", "*.pyc", "__pycache__/"]
end
