# =============================================================
# Shared environment variables for all stacks
# IMPORTANT: Change all default values before deploying!
# Do NOT commit this file to version control.
# =============================================================

# --- Checkmk ---
CMK_PASSWORD=cmk

# --- Grafana ---
GF_SECURITY_ADMIN_PASSWORD=cmk

# --- InfluxDB ---
INFLUXDB_USERNAME=cmk
INFLUXDB_PASSWORD=cmk1234567
INFLUXDB_ORG=myorg
INFLUXDB_BUCKET=mybucket
INFLUXDB_ADMIN_TOKEN=mytoken

# --- OpenLDAP ---
LDAP_ADMIN_PASSWORD=cmk
LDAP_CONFIG_PASSWORD=cmk

# --- Mailpit ---
MP_SMTP_AUTH=thanos1:cmk1234567 user2:password
MP_POP3_AUTH=thanos1:cmk1234567 user2:password

# --- Jolokia ---
JOLOKIA_BASIC_AUTH=jolokia_user:jolokia_pw

# --- SNMPSim ---
SNMPSIM_V3_AUTH_KEY=testing1234567
SNMPSIM_V3_PRIV_KEY=privkey1234567
