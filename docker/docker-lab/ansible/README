#!/bin/bash



cp /home/checkmk/config/user_connections.mk /omd/sites/ldap/etc/check_mk/multisite.d/wato/user_connections.mk
chown ldap. /omd/sites/ldap/etc/check_mk/multisite.d/wato/user_connections.mk



cp /home/cert/root_ca.crt /usr/local/share/ca-certificates/
update-ca-certificates
omd restart ldap

